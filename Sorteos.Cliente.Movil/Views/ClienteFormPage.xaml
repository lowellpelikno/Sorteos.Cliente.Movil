<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sorteos.Cliente.Movil.ViewModels"
             x:Class="Sorteos.Cliente.Movil.Views.ClienteFormPage"
             x:Name="thisPage"
             x:DataType="vm:ClienteFormViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- Datos Personales -->
            <Border StrokeShape="RoundRectangle 8"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Datos del Cliente"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDarkText}"
                           Margin="0,0,0,4" />

                    <!-- Nombre -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre(s) *:" FontSize="13" FontAttributes="Bold" TextColor="#333333" />
                        <Entry Text="{Binding Nombre}" Placeholder="Ej. Juan Carlos" />
                    </VerticalStackLayout>

                    <!-- Apellido Paterno -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Apellido Paterno:" FontSize="13" FontAttributes="Bold" TextColor="#333333" />
                        <Entry Text="{Binding ApellidoPaterno}" Placeholder="Ej. Pérez" />
                    </VerticalStackLayout>

                    <!-- Apellido Materno -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Apellido Materno:" FontSize="13" FontAttributes="Bold" TextColor="#333333" />
                        <Entry Text="{Binding ApellidoMaterno}" Placeholder="Ej. López" />
                    </VerticalStackLayout>

                    <!-- Telefono -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Teléfono (WhatsApp) *:" FontSize="13" FontAttributes="Bold" TextColor="#333333" />
                        <Entry Text="{Binding Telefono}" Keyboard="Numeric" MaxLength="10" Placeholder="Ej. 5512345678" />
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Correo Electrónico (opcional):" FontSize="13" FontAttributes="Bold" TextColor="#333333" />
                        <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="ejemplo@correo.com" />
                    </VerticalStackLayout>

                    <!-- Activo -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                        <Label Grid.Column="0" Text="Cliente Activo" VerticalOptions="Center" FontSize="14" FontAttributes="Bold" />
                        <Switch Grid.Column="1" IsToggled="{Binding Activo}" HorizontalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Numeros de Planta -->
            <Border StrokeShape="RoundRectangle 8"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Números de Planta (Fijos)"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDarkText}" />

                    <Label Text="Asigna los números reservados que este cliente juega permanentemente en cada sorteo."
                           FontSize="12"
                           TextColor="#616161" />

                    <!-- Agregar nuevo numero -->
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding NuevoNumeroPlantaTexto}"
                               Keyboard="Numeric"
                               Placeholder="Ej. 07 o 42" />

                        <Button Grid.Column="1"
                                Text="Agregar"
                                Command="{Binding AgregarNumeroPlantaCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="44"
                                Padding="16,0"
                                CornerRadius="6" />
                    </Grid>

                    <!-- Lista de numeros asignados -->
                    <CollectionView ItemsSource="{Binding NumerosPlanta}"
                                    ItemSizingStrategy="MeasureFirstItem"
                                    Margin="0,8,0,0">
                        <CollectionView.EmptyView>
                            <Label Text="No tiene números de planta asignados."
                                   FontSize="13"
                                   TextColor="#9E9E9E"
                                   Margin="0,8" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:Int32">
                                <Border StrokeShape="RoundRectangle 6"
                                        Stroke="{StaticResource IndigoBorder}"
                                        BackgroundColor="{StaticResource Secondary}"
                                        Padding="12,8"
                                        Margin="0,3">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding ., StringFormat='Número: {0:D2}'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDarkText}"
                                               VerticalOptions="Center" />

                                        <Button Grid.Column="1"
                                                Text="Quitar"
                                                Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.QuitarNumeroPlantaCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFEBEE"
                                                TextColor="#C62828"
                                                FontSize="11"
                                                Padding="10,0"
                                                HeightRequest="32"
                                                CornerRadius="4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Botones Guardar / Cancelar -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        BackgroundColor="#EEEEEE"
                        TextColor="#424242"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="46" />

                <Button Grid.Column="1"
                        Text="Guardar"
                        Command="{Binding GuardarCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="46" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

