<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Sorteos.Cliente.Movil.ViewModels"
             xmlns:models="clr-namespace:Sorteos.Cliente.Movil.Models"
             x:Class="Sorteos.Cliente.Movil.Views.PremioListPage"
             x:Name="thisPage"
             x:DataType="vm:PremioListViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Barra de Busqueda -->
        <SearchBar Grid.Row="0"
                   Placeholder="Buscar por lugar, descripción o monto..."
                   Text="{Binding FiltroTexto}"
                   Margin="12,8" />

        <!-- Boton Nuevo Premio -->
        <Button Grid.Row="1"
                Text="+ Nuevo Premio"
                Command="{Binding NuevoPremioCommand}"
                Margin="12,0,12,8"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="44" />

        <!-- Indicador de Carga -->
        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Lista de Premios -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Premios}"
                        ItemSizingStrategy="MeasureFirstItem"
                        Margin="12,0"
                        IsVisible="{Binding IsNotBusy}">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Margin="0,50,0,0">
                    <Label Text="No se encontraron premios"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="Gray" />
                    <Label Text="Presiona '+ Nuevo Premio' para registrar uno."
                           FontSize="14"
                           HorizontalOptions="Center"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PremioLocal">
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="14"
                            Margin="0,4">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                            <!-- Lugar y Monto -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding LugarTexto}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#212121" />

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ValorFormateado}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"
                                   HorizontalOptions="End" />

                            <!-- Descripcion Larga -->
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding DescripcionLarga}"
                                   FontSize="14"
                                   TextColor="#616161"
                                   Margin="0,4,0,0" />

                            <!-- Conteo de Sorteos y Acciones -->
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="6" Margin="0,8,0,0">
                                <Label Text="Sorteos asignados:" FontSize="12" TextColor="#9E9E9E" />
                                <Label Text="{Binding CantidadSorteosAsignados}" FontSize="12" FontAttributes="Bold" TextColor="#9E9E9E" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8" Margin="0,4,0,0" HorizontalOptions="End">
                                <Button Text="Editar"
                                        Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.EditarPremioCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="36"
                                        FontSize="12"
                                        Padding="10,0"
                                        BackgroundColor="{StaticResource Secondary}"
                                        TextColor="{StaticResource Primary}"
                                        CornerRadius="6" />

                                <Button Text="Eliminar"
                                        Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.EliminarPremioCommand}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="36"
                                        FontSize="12"
                                        Padding="10,0"
                                        BackgroundColor="#FFEBEE"
                                        TextColor="#C62828"
                                        CornerRadius="6" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
